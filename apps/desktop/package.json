{
  "name": "@ponzu/desktop",
  "productName": "Ponzu",
  "private": true,
  "version": "1.80.1",
  "description": "Ponzu desktop app",
  "homepage": "https://ponzu.design",
  "type": "module",
  "main": "dist/main.cjs",
  "exports": {
    "./bridge": "./src/bridge.ts"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "start": "bun run build && ./run-dev.sh",
    "dist": "bun run build && bun run --filter @ponzu/studio build && electron-builder --mac --arm64 --publish never",
    "package:dir": "bun run build && bun run --filter @ponzu/studio build && electron-builder --dir --publish never",
    "package:dev": "bun scripts/package-dev.ts",
    "icons:dev": "bash scripts/make-dev-icon.sh",
    "icons:installer": "bash scripts/make-installer-icon.sh",
    "icons:platforms": "swift scripts/make-platform-icons.swift build/icon-1024.png build"
  },
  "devDependencies": {
    "@ponzu/canvas": "workspace:*",
    "@ponzu/client": "workspace:*",
    "@ponzu/core": "workspace:*",
    "@types/node": "^26.6.5",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "design.ponzu.app",
    "extraMetadata": {
      "name": "ponzu"
    },
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../studio/dist",
        "to": "studio"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "afterSign": "./scripts/notarize.cjs",
    "protocols": [
      {
        "name": "Ponzu",
        "schemes": [
          "ponzu"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${arch}.${ext}",
      "icon": "build/installer-icon.icns",
      "iconSize": 80,
      "contents": [
        {
          "x": 130,
          "y": 124
        },
        {
          "x": 410,
          "y": 124,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "north-brook",
      "repo": "ponzu",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/uninstall.ps1",
          "to": "uninstall.ps1"
        }
      ]
    },
    "linux": {
      "executableName": "ponzu",
      "icon": "build/icons",
      "category": "Graphics",
      "synopsis": "Design with Claude on a canvas, and ship pull requests",
      "maintainer": "Northbrook <https://ponzu.design>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-${arch}.${ext}",
      "include": "build/installer.nsh"
    },
    "appImage": {
      "artifactName": "${productName}-x64.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-x64.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
