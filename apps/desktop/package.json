{
  "name": "@ponzu/desktop",
  "productName": "Ponzu",
  "private": true,
  "version": "1.53.5",
  "description": "Ponzu desktop app",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "bun ../../scripts/release-notes.ts dist/release-notes.json && bun build src/main.ts --target node --format cjs --outfile dist/main.cjs --external electron && bun build src/preload.ts --target node --format cjs --outfile dist/preload.cjs --external electron && bun build ../cli/src/index.ts --compile --external playwright-core --external @ponzu/render/chromium --external @opentelemetry/api --external rxjs --env='PONZU_POSTHOG_*' --outfile dist/server/ponzu",
    "start": "bun run build && ./run-dev.sh",
    "dist": "bun run build && bun run --filter @ponzu/studio build && electron-builder --mac --arm64 --publish never",
    "package:dir": "bun run build && bun run --filter @ponzu/studio build && electron-builder --dir --publish never",
    "icons:installer": "bash scripts/make-installer-icon.sh"
  },
  "devDependencies": {
    "@ponzu/core": "workspace:*",
    "@ponzu/server": "workspace:*",
    "@types/node": "^26.6.5",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "design.ponzu.app",
    "extraMetadata": {
      "name": "ponzu"
    },
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../studio/dist",
        "to": "studio"
      },
      {
        "from": "dist/server",
        "to": "server"
      }
    ],
    "afterPack": "./scripts/quicklook.cjs",
    "afterSign": "./scripts/notarize.cjs",
    "fileAssociations": [
      {
        "ext": "design",
        "name": "Ponzu Design",
        "role": "Editor",
        "isPackage": true,
        "icon": "build/icon.icns"
      }
    ],
    "protocols": [
      {
        "name": "Ponzu",
        "schemes": [
          "ponzu"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "extendInfo": {
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "design.ponzu.design",
            "UTTypeDescription": "Ponzu Design",
            "UTTypeConformsTo": [
              "com.apple.package",
              "public.composite-content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "design"
              ]
            }
          }
        ]
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "sign": "./scripts/quicklook.cjs",
      "notarize": false,
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${arch}.${ext}",
      "icon": "build/installer-icon.icns",
      "iconSize": 80,
      "contents": [
        {
          "x": 130,
          "y": 124
        },
        {
          "x": 410,
          "y": 124,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "north-brook",
      "repo": "ponzu",
      "releaseType": "draft"
    },
    "linux": {
      "executableName": "ponzu",
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
