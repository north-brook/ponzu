# Every variable the API reads (src/env.ts). Names and meanings only: never put a value here.
# Locally, `bun run dev` reads these from the shell or from apps/api/.env.local, which is ignored.

# Neon's pooled connection string. Until cutover this is the `dev` branch everywhere.
# `bun run dev` looks it up itself when NEON_API_KEY and NEON_PROJECT_ID are set instead.
DATABASE_URL=

# WorkOS (AuthKit): the environment's API key and client id. Staging until cutover.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# The Ponzu GitHub App: its client id and secret, and its private key as the PEM GitHub gave,
# all of its lines, unescaped. (`bun run dev` also accepts GITHUB_APP_PRIVATE_KEY_PATH.)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# The App's slug (github.com/apps/<slug>), where an install begins, and the secret GitHub signs
# webhook deliveries with: at least 32 random characters, the same as the App's webhook settings.
# `bun scripts/github-webhook.ts configure` points the App's webhook here with this secret.
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# The GitHub user id of the App's bot, who commits are committed by: the `id` of
# `gh api 'users/<slug>%5Bbot%5D'`. Not a secret.
GITHUB_APP_BOT_USER_ID=

# What Vercel's cron sends as its bearer token to /v1/cron/minute: at least 32 random characters.
# Vercel reads this exact name from the project.
CRON_SECRET=

# The key stored secrets are sealed with: 32 random bytes in base64url (`openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`).
# Losing it loses every stored GitHub token; people would have to sign in again.
PONZU_VAULT_KEY=

# Vercel Sandbox, where canvases' sandboxes run. On Vercel the API uses its functions' OIDC
# token and these must be unset (a VERCEL_TOKEN there is refused). Off Vercel (`bun run dev`, a
# script), all three or none: a token scoped to the team and the ponzu-api project, the team's id
# (team_…) and the project's id (prj_…). The image every sandbox runs is not a variable: it is
# apps/runner/image/current.json, built into the API.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Optional. Where a sandbox's runner reaches this API; https://api.ponzu.design when unset. Set it
# to a tunnel's address to run canvases against `bun run dev`.
PONZU_API_URL=

# Optional. How long a sandbox stays awake after the last activity, in seconds; 300 when unset.
PONZU_SANDBOX_IDLE_SECONDS=

# Optional. How many sandboxes may be waking or awake at once in one workspace (5 when unset) and
# for one canvas owner (3 when unset). A wake past either waits, and the canvas says so.
PONZU_SANDBOX_MAX_PER_WORKSPACE=
PONZU_SANDBOX_MAX_PER_OWNER=

# Neon Realtime on the same branch as DATABASE_URL: its invocation URL, which clients subscribe
# to, and its secret, which seals live queries. Neon's API has both per branch
# (`/branches/{id}/realtime` and `/branches/{id}/realtime/secret`); `bun run dev` looks them up
# itself the way it does DATABASE_URL.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# Where a canvas's files are served from: https://assets.ponzu.cloud, and until cutover the dev
# bucket's https://assets-dev.ponzu.cloud.
PONZU_ASSETS_URL=

# The Cloudflare R2 bucket served at PONZU_ASSETS_URL: the account id (32 hex characters), an R2
# API token's S3 access key id and secret with write access to the bucket, and the bucket's name.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Ponzu's own Anthropic API key (sk-ant-…), which pays for what the API asks a model itself: the
# four ideas under the create composer, from Claude Haiku through the AI SDK's Anthropic
# provider. Never a person's Claude account.
PONZU_ANTHROPIC_API_KEY=

# Optional. Keys that were PONZU_VAULT_KEY before, comma-separated, so what they sealed still opens.
PONZU_VAULT_OLD_KEYS=

# Optional. The oldest client each platform may run, like `macos=2.1.0,ios=1.3.0`. Unset means no gate.
PONZU_MIN_CLIENT_VERSIONS=

# Optional. PostHog (docs/analytics.md): the environment's project token (phc_…, public), where it
# takes events (https://us.i.posthog.com when unset), and "1" to record prompts and answers in
# LLM analytics (off when unset). Without the token nothing is captured. The API hands all three
# to each canvas's runner when it starts.
PONZU_POSTHOG_KEY=
PONZU_POSTHOG_HOST=
PONZU_POSTHOG_AI_CONTENT=

# Optional. Notifications: an access token for Ponzu's Expo project (expo.dev, the project's
# access tokens), which has Enhanced Security for push turned on. Unset, push is off: no ping
# reaches a phone, and the Mac and the inbox work regardless. A secret: on Vercel, set it as
# sensitive.
EXPO_ACCESS_TOKEN=

# Optional. Notifications: Resend's API key, for the daily email digest. Unset, email is off and
# Settings hides the Email row. A secret: on Vercel, set it as sensitive.
RESEND_API_KEY=

# Optional. Feature switches (src/features.ts), each off when unset.
# PONZU_BILLING: off, observe (the gate is computed and what it would refuse is logged) or on.
# PONZU_REPO_BASES and PONZU_MERGE_QUEUE: "1" to turn repo bases, or merging through a merge
# queue, on.
# PONZU_RATE_LIMITS: off, or "vercel" for per-caller limits through Vercel's firewall, which works
# only on Vercel. A check that times out or finds no rule lets the request through.
# PONZU_MAINTENANCE: off, wakes_paused (nothing wakes; messages wait) or read_only (wakes paused,
# and writes answer 503 maintenance; reads, health, the cron and runner heartbeats go on).
PONZU_BILLING=
PONZU_REPO_BASES=
PONZU_MERGE_QUEUE=
PONZU_RATE_LIMITS=
PONZU_MAINTENANCE=
