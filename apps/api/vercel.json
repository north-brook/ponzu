{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hono",
  "installCommand": "bun install --frozen-lockfile --ignore-scripts --filter @ponzu/api",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "crons": [{ "path": "/v1/cron/minute", "schedule": "* * * * *" }]
}
