# Optional. Leave the key unset and the app sends nothing. Release builds get
# it from the EAS production environment.
# EXPO_PUBLIC_POSTHOG_KEY=phc_your_project_token
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Production EAS builds upload Hermes source maps and dSYMs to PostHog. Set
# only if you want a local build to do the same; it adds the Expo plugin.
# POSTHOG_CLI_API_KEY=
# POSTHOG_CLI_PROJECT_ID=

# Development only: a Ponzu on this Mac for the simulator to use as a paired
# Mac, e.g. a branch server (`bun apps/cli/src/index.ts serve … --port 7792`).
# Put it in .env.local. Release builds ignore it.
# EXPO_PUBLIC_PONZU_DEV_HOST=127.0.0.1:7792
