# Copy what you need to .env.local (ignored). None of these is a secret: the
# app ships them. EAS sets them per environment for its builds.

# The API the app talks to. Unset: Ponzu Dev uses https://api-dev.ponzu.design,
# and a production build stops at launch, since it has no default.
# EXPO_PUBLIC_PONZU_API_URL=https://api-dev.ponzu.design
# The WorkOS staging environment's client id (public). Without it a real
# build can't sign in, and says so.
# EXPO_PUBLIC_WORKOS_CLIENT_ID=

# Optional. Leave the key unset and the app sends nothing.
# EXPO_PUBLIC_POSTHOG_KEY=phc_your_project_token
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Production EAS builds upload Hermes source maps and dSYMs to PostHog. Set
# only if you want a local build to do the same; it adds the Expo plugin.
# POSTHOG_CLI_API_KEY=
# POSTHOG_CLI_PROJECT_ID=

# Build and bundle time, not .env.local: set them on the command line.
# APP_VARIANT=dev            Ponzu Dev (design.ponzu.app.dev, ponzu-dev://)
# PONZU_BACKEND=fake         the in-app fake backend, for tests and demos
# EXPO_PUBLIC_PONZU_FAKE_AUTHORIZE_URL=http://127.0.0.1:<port>/authorize
#                            the fake's sign-in page (maestro/authorize.ts)
