          "image": "./assets/splash.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#ffc81e"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ponzu uses the camera to scan the pairing code on your Mac.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "Ponzu turns what you say into comment text, on this iPhone.",
          "microphonePermission": "Ponzu listens while you dictate a comment, and turns it into text on this iPhone."
        }
      ],
      "expo-notifications"
