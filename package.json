{
  "name": "ponzu-monorepo",
  "private": true,
  "version": "1.15.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @ponzu/studio dev & PONZU_TELEMETRY=0 bun apps/cli/src/index.ts serve examples/halon.design examples/kettle.design examples/weft.design --dev",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.2"
}
