{
  "extends": "./tsconfig.base.json",
  // The studio's shadcn imports (apps/studio/components.json).
  "compilerOptions": { "paths": { "@/*": ["./apps/studio/src/*"] } },
  "include": [
    "packages/*/src",
    "apps/api/src",
    "apps/api/scripts",
    "apps/cli/src",
    "apps/runner/src",
    "apps/runner/scripts",
    "apps/studio/src",
    "apps/studio/scripts",
    "apps/desktop/src/**/*.test.ts",
    "scripts"
  ]
}
